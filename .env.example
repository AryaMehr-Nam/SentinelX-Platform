# SentinelX Environment Configuration
# Copy this file to .env and update values for your environment

# ──── Database ────
DATABASE_URL=postgresql+asyncpg://sentinelx:sentinelx-secret@localhost:5432/sentinelx
DATABASE_ECHO=false

# ──── Redis ────
REDIS_URL=redis://:sentinelx-redis@localhost:6379/0

# ──── Elasticsearch ────
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX_PREFIX=sentinelx

# ──── JWT Authentication ────
JWT_SECRET_KEY=change-this-to-a-secure-random-string-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ──── CORS ────
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","chrome-extension://*"]

# ──── WAF Configuration ────
WAF_ENABLED=true
WAF_MODE=block
WAF_LOG_LEVEL=info
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# ──── Celery ────
CELERY_BROKER_URL=redis://:sentinelx-redis@localhost:6379/1
CELERY_RESULT_BACKEND=redis://:sentinelx-redis@localhost:6379/2

# ──── AI / LLM Configuration ────
LLM_PROVIDER=ollama
LLM_MODEL=llama3
LLM_API_BASE=http://localhost:11434
LLM_API_KEY=

# For OpenAI:
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o
# LLM_API_KEY=sk-...

# For Anthropic:
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-sonnet-4-20250514
# LLM_API_KEY=sk-ant-...

# ──── Threat Intelligence APIs ────
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=

# ──── Application ────
APP_NAME=SentinelX
APP_VERSION=1.0.0
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000

# ──── Admin Seed ────
ADMIN_EMAIL=admin@sentinelx.io
ADMIN_PASSWORD=sentinelx-admin
